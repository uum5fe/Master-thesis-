# ---------------------------------------------------------------------------
# Local EIS dashboard -- every path the application knows lives in this file.
#
#   copy this file to  .env  and edit the paths.
#
# These are the same variable names the existing Local EIS viewer uses, so one
# .env serves both applications.  No module in this project contains a personal
# path.
#
# Anything already set in the real environment WINS over this file, so a
# one-off override is `set EIS_FAMOS_ROOT=...` rather than editing the file and
# remembering to change it back.  EIS_SKIP_DOTENV=1 ignores the file entirely.
#
# WINDOWS AND UNC PATHS NEED NO ESCAPING.  The whole rest of the line after the
# first "=" is the value; backslashes are not escape characters here.  Do not
# wrap them in quotes unless the value itself contains a "#".
# ---------------------------------------------------------------------------

# ---- REQUIRED: where measurements are read from, where results are written --

EIS_FAMOS_ROOT=\\bosch.com\DfsRB\DfsDE\LOC\Fe\ILM\A_ILM_DSETD\Gruppenablage\EAT3\Charan\Lokale_EIS\Daten\2612030_07_09
EIS_RESULTS_ROOT=\\bosch.com\DfsRB\DfsDE\LOC\Fe\ILM\A_ILM_DSETD\Gruppenablage\EAT3\Charan\Lokale_EIS\Daten\EIS_Results

# Already-extracted CSV measurements.  Used instead of EIS_FAMOS_ROOT when
# EIS_SOURCE=csv, which bypasses the bronze stage entirely.
EIS_CSV_ROOT=\\bosch.com\DfsRB\DfsDE\LOC\Fe\ILM\A_ILM_DSETD\Gruppenablage\EAT3\Charan\Lokale_EIS\csv_files

# ---- CALIBRATION ----------------------------------------------------------

# Per-segment current Abgleich, 72 rows of "c0;c1".  Without it the segment
# currents stay uncalibrated and R_ohmic carries the raw shunt gain.
EIS_CURR_CAL=\\bosch.com\DfsRB\DfsDE\LOC\Fe\ILM\A_ILM_DSETD\Gruppenablage\EAT3\Charan\Lokale_EIS\Daten\curr.csv
# Per-sensor temperature Abgleich, 4 rows of "c0;c1".
EIS_TEMP_CAL=\\bosch.com\DfsRB\DfsDE\LOC\Fe\ILM\A_ILM_DSETD\Gruppenablage\EAT3\Charan\Lokale_EIS\Daten\temp.csv
# Optional per-segment area override CSV.
EIS_AREAS_FILE=

# ---- REFERENCE / CROSS-CHECK ----------------------------------------------

# Folder of whole-cell Gamry .DTA sweeps.  Empty = skip the whole-cell check.
EIS_GAMRY_ROOT=\\bosch.com\DfsRB\DfsDE\LOC\Fe\ILM\A_ILM_DSETD\Gruppenablage\EAT3\Charan\Lokale_EIS\EIS_Daten_Gamry_Tom

# ---- WHAT TO RUN ----------------------------------------------------------

# 1 lets the Run page launch the pipeline.  Unset or 0 = browse results only,
# and EIS_PIPELINE_DIR is then not required.
EIS_ALLOW_INLINE_PIPELINE=1

# famos (default) reads EIS_FAMOS_ROOT; csv reads EIS_CSV_ROOT.
EIS_SOURCE=famos
# gen1 = green/Kashyyyk, gen2 = blue/Naboo.  "gen1_r2d2_72" is also accepted.
EIS_DEFAULT_PLATE=gen1
# Order id, e.g. 2612030.  Empty = read it from the filenames.
EIS_LEEPA=
# Default selection on the Run page.  ALL = every condition found.
EIS_CONDITIONS=ALL

# ---- WHERE THE PIPELINE LIVES ---------------------------------------------

# >>> THE ONE LINE YOU ALMOST CERTAINLY HAVE TO EDIT <<<
# Directory holding main.py / bronze.py / silver.py / gold.py -- your
# Local_Eis_Evaluation folder.  Only needed when EIS_ALLOW_INLINE_PIPELINE=1;
# leave it wrong and the Run page says so rather than failing obscurely.
# A relative path resolves against this file's directory.
EIS_PIPELINE_DIR=C:\path\to\Local_Eis_Evaluation_both
# Interpreter used to run the pipeline.  Empty = the one running the dashboard.
EIS_PYTHON=

# ---- DASHBOARD ------------------------------------------------------------

EIS_DASHBOARD_PORT=8501
EIS_TITLE=Local EIS
