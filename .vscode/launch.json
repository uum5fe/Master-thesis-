{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Dashboard",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/run_dashboard.py",
      "console": "integratedTerminal",
      "justMyCode": false,
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Dashboard (open browser, no reloader)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/run_dashboard.py",
      "args": ["--open", "--no-reload"],
      "console": "integratedTerminal",
      "justMyCode": false,
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Evaluate one condition (writes results)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/run_evaluation.py",
      "args": ["--stage-local"],
      "console": "integratedTerminal",
      "justMyCode": false,
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Tests",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["-q"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    }
  ]
}
