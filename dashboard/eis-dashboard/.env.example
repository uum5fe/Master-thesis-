# ---------------------------------------------------------------------------
# Local EIS dashboard - every path the application knows lives in this file.
#
#   cp .env.example .env     and edit the two paths under "REQUIRED".
#
# No module in this project contains a personal path.  Anything already set in
# the real environment WINS over this file, so a one-off override is
# `set EIS_DAT_DIR=...` rather than editing and remembering to change it back.
#
# Windows paths need no escaping - the whole rest of the line is the value:
#   EIS_DAT_DIR=C:\Users\me\OneDrive - Bosch Group\Famos
# ---------------------------------------------------------------------------

# ---- REQUIRED -------------------------------------------------------------

# Directory of FAMOS .DAT recordings (the "in :" line in the pipeline banner).
EIS_DAT_DIR=/Volumes/ps_xplatform_dev/rvadvtec_dev/ev_rvadvtec_dev/Famos

# Where results are written.  One sub-directory per plate/condition is created
# underneath, e.g.  <EIS_OUT_DIR>/2612030/150A/{bronze,silver,gold}
EIS_OUT_DIR=./results

# ---- CALIBRATION (optional, but R_ohmic is uncalibrated without curr-cal) --

# Per-segment current Abgleich, 72 rows of "c0;c1".
EIS_CURR_CAL=/Workspace/Users/uum5fe@bosch.com/curr.csv
# Per-sensor temperature Abgleich, 4 rows of "c0;c1".
EIS_TEMP_CAL=
# Optional per-segment area override CSV.
EIS_AREAS=
# Optional ex-situ chain response.
EIS_GAIN=

# ---- REFERENCE / CROSS-CHECK (optional) -----------------------------------

# Folder of whole-cell Gamry .DTA sweeps.  Empty = skip the whole-cell check.
EIS_GAMRY_DIR=
# ASAM MDF4 bench log; defaults to whatever is found in EIS_GAMRY_DIR.
EIS_BENCH_LOG=

# ---- WHAT TO RUN ----------------------------------------------------------

# gen1 = green/Kashyyyk, gen2 = blue/Naboo
EIS_PLATE=gen1
# Order id, e.g. 2612030.  Empty = let the pipeline discover it.
EIS_LEEPA=2612030
# Comma-separated default selection, e.g. 45A,150A,450A.  ALL = every one found.
EIS_CONDITIONS=ALL

# ---- WHERE THE PIPELINE LIVES ---------------------------------------------

# Directory containing main.py / bronze.py / silver.py / gold.py.
# Relative paths resolve against this file's directory.
EIS_PIPELINE_DIR=../../databricks/local_eis
# Interpreter used to run the pipeline.  Empty = the one running the dashboard.
EIS_PYTHON=

# ---- DASHBOARD ------------------------------------------------------------

EIS_DASHBOARD_PORT=8501
# Read-only mode: browse existing results, hide the "Run pipeline" controls.
EIS_READ_ONLY=0
